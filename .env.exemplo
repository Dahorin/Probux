# Configuraes de Email para o Probux
# Renomeie este arquivo para .env e preencha com suas credenciais

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app_de_16_caracteres
MAIL_DEFAULT_SENDER=seu_email@gmail.com

# Chave secreta para sessoes Flask
SECRET_KEY=sua_chave_secreta_super_forte
